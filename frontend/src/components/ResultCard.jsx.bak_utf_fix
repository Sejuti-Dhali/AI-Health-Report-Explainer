import React from "react";

const getStatusStyles = (status) => {
  const s = String(status || "").toLowerCase();

  if (s === "high" || s === "low" || s === "abnormal") {
    return {
      border: "border-amber-300 dark:border-amber-500",
      badge: "bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300",
      dot: "bg-amber-500",
      label: "Needs attention",
    };
  }

  if (s === "normal") {
    return {
      border: "border-emerald-300 dark:border-emerald-500",
      badge: "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300",
      dot: "bg-emerald-500",
      label: "Within range",
    };
  }

  return {
    border: "border-slate-300 dark:border-slate-700",
    badge: "bg-slate-100 text-slate-600 dark:bg-slate-800 dark:text-slate-300",
    dot: "bg-slate-400",
    label: "Uncertain",
  };
};

const getConfidenceStyles = (band) => {
  const b = String(band || "low").toLowerCase();

  if (b === "high") {
    return "bg-emerald-100 text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300";
  }
  if (b === "moderate") {
    return "bg-amber-100 text-amber-700 dark:bg-amber-500/10 dark:text-amber-300";
  }
  return "bg-rose-100 text-rose-700 dark:bg-rose-500/10 dark:text-rose-300";
};

export default function ResultCard({ result }) {
  const status = result?.status || "uncertain";
  const styles = getStatusStyles(status);

  const confidenceBand = result?.confidence_band || "low";
  const confidenceScore =
    typeof result?.confidence_score === "number" ? result.confidence_score : null;

  const evidence = Array.isArray(result?.retrieved_evidence)
    ? result.retrieved_evidence.slice(0, 3)
    : [];

  const needsManualReview = !!result?.needs_manual_review;
  const hallucinationFlag = !!result?.hallucination_flag;
  const evidenceSupport = !!result?.evidence_support;

  return (
    <div
      className={`rounded-3xl bg-white/80 dark:bg-slate-900/80 backdrop-blur border ${styles.border} p-6 shadow-sm hover:shadow-lg transition`}
    >
      <div className="flex justify-between items-start gap-4">
        <div className="flex gap-3">
          <span className={`mt-2 h-3 w-3 rounded-full ${styles.dot}`} />
          <div>
            <h3 className="text-xl font-semibold text-slate-900 dark:text-white">
              {result?.test || "Unknown test"}
            </h3>
            <p className="text-sm text-slate-500 dark:text-slate-400">
              {result?.reference || "No reference available"}
            </p>
          </div>
        </div>

        <span
          className={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${styles.badge}`}
        >
          {styles.label}
        </span>
      </div>

      <div className="mt-5 grid grid-cols-1 md:grid-cols-3 gap-4">
        <div className="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4">
          <p className="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Value
          </p>
          <p className="mt-1 text-lg font-semibold text-slate-900 dark:text-white">
            {result?.value ?? "—"} {result?.unit || ""}
          </p>
        </div>

        <div className="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4">
          <p className="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Confidence
          </p>
          <div className="mt-2 flex flex-wrap gap-2">
            <span
              className={`inline-flex items-center rounded-full px-3 py-1 text-xs font-medium ${getConfidenceStyles(confidenceBand)}`}
            >
              {confidenceBand}
              {confidenceScore !== null ? ` (${confidenceScore.toFixed(2)})` : ""}
            </span>
          </div>
        </div>

        <div className="rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4">
          <p className="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Review status
          </p>
          <div className="mt-2 flex flex-wrap gap-2">
            {needsManualReview ? (
              <span className="inline-flex items-center rounded-full bg-rose-100 px-3 py-1 text-xs font-medium text-rose-700 dark:bg-rose-500/10 dark:text-rose-300">
                Manual review recommended
              </span>
            ) : (
              <span className="inline-flex items-center rounded-full bg-emerald-100 px-3 py-1 text-xs font-medium text-emerald-700 dark:bg-emerald-500/10 dark:text-emerald-300">
                No manual review flag
              </span>
            )}

            {hallucinationFlag || !evidenceSupport ? (
              <span className="inline-flex items-center rounded-full bg-amber-100 px-3 py-1 text-xs font-medium text-amber-700 dark:bg-amber-500/10 dark:text-amber-300">
                Low evidence support
              </span>
            ) : null}
          </div>
        </div>
      </div>

      <div className="mt-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4">
        <p className="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
          Explanation
        </p>
        <p className="mt-2 text-sm leading-6 text-slate-700 dark:text-slate-200">
          {result?.explanation || "No explanation available."}
        </p>
      </div>

      {evidence.length > 0 ? (
        <div className="mt-5 rounded-2xl bg-slate-50 dark:bg-slate-800/60 p-4">
          <p className="text-xs uppercase tracking-wide text-slate-500 dark:text-slate-400">
            Evidence
          </p>
          <div className="mt-3 space-y-3">
            {evidence.map((item, idx) => (
              <div
                key={`${item?.title || "evidence"}-${idx}`}
                className="rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-900 p-3"
              >
                <p className="text-sm font-medium text-slate-800 dark:text-slate-100">
                  {item?.title || "Untitled source"}
                </p>
                <p className="mt-1 text-xs text-slate-500 dark:text-slate-400">
                  {item?.source || "unknown source"}
                </p>
                <p className="mt-2 text-sm text-slate-700 dark:text-slate-200">
                  {item?.snippet || ""}
                </p>
              </div>
            ))}
          </div>
        </div>
      ) : null}
    </div>
  );
}
